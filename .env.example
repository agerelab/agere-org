# Local development: an embedded Postgres (PGlite) in .data/ — no server needed. This is also the
# default when DATABASE_URL is empty outside production.
# Production: the Vercel Marketplace Postgres (PRD-00 D2), region Singapore, pooled connection string
# (Neon "-pooler" host, Supabase port 6543), e.g. postgres://…
DATABASE_URL=pglite://.data/agere-org

# Public base URL used in email links. Defaults to the request's own origin.
# APP_URL=http://localhost:3000

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" (TECH-01 §9).
CRON_SECRET=
