# Postgres from the Vercel Marketplace (PRD-00 D2), region Singapore.
# On Vercel use the provider's pooled connection string (Neon "-pooler" host, Supabase port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agere_org

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" (TECH-01 §9).
CRON_SECRET=

# The identity module (PRD-01) does not exist yet. Locally, DEV_AUTH=1 runs every request as this
# user in this organization with this role (ignored in production builds).
DEV_AUTH=1
DEV_ORGANIZATION_ID=00000000-0000-7000-8000-000000000001
DEV_USER_ID=00000000-0000-7000-8000-000000000002
DEV_ROLE=owner

# Front end on in-memory fakes (TECH-01 §8), so FE can work before BE lands a module.
NEXT_PUBLIC_FAKE_BACKEND=1
